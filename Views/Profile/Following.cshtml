@model List<ProfileViewModel>

@{
    ViewData["Title"] = "Following";
}

<!DOCTYPE html>

<html>
<head>
    <title>Following</title>
</head>
<body>
<div>
    <h1>Following</h1>
    @if (Model.Count == 0)
    {
        <p>This user isn't following anyone! :(</p>
    }
    else
    {
        foreach (var user in Model)
        {
            <partial name="_ProfileSlice" model="user"/>
        }
    }
</div>
</body>
</html>